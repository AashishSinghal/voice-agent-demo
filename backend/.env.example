# Server
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- LLM -------------------------------------------------------------------
# "groq"   — hosted, no local model needed. Simplest way to run locally.
# "ollama" — fully local/offline, but needs Ollama installed and a model pulled.
LLM_PROVIDER=groq

# Groq is used for Whisper STT always, and for the LLM when LLM_PROVIDER=groq.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Current free chat models: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b

# Only used when LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi3

# --- TTS -------------------------------------------------------------------
# "say"   — macOS built-in. Zero setup; use this for local dev on a Mac.
# "groq"  — hosted Orpheus. Used in deployment: synthesis is a network call,
#           so it does not care that the free instance has 0.1 vCPU.
# "piper" — local binary + ONNX voice. Needs real CPU.
TTS_PROVIDER=say
SAY_VOICE=Samantha

# Only used when TTS_PROVIDER=groq
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy

# Only used when TTS_PROVIDER=piper
PIPER_MODEL=en_US-lessac-medium
PIPER_MODEL_PATH=./models/piper
PIPER_BIN=piper

# --- Speech to text ---------------------------------------------------------
# Spoken language passed to Whisper (ISO-639-1 code).
STT_LANGUAGE=en
# Whisper model. Keep in step with the cost table in services/cost.ts.
# GROQ_STT_MODEL=whisper-large-v3

# --- Abuse protection -------------------------------------------------------
# Protects the Groq free quota (~1,000 requests/day, ~5 per turn). All limits
# are in memory and per process; 0 disables a limit.
#
# Number of reverse proxies in front of this server. 0 ignores X-Forwarded-For
# (the client could forge it). Render puts one proxy in front: use 1 there.
TRUST_PROXY=0
# Open sockets per IP, and new connections per IP per minute.
MAX_SOCKETS_PER_IP=3
MAX_CONNECTS_PER_MIN_PER_IP=20
# Turns per IP per minute. A refused turn shows an error in the UI.
MAX_TURNS_PER_MIN_PER_IP=8
# Turns per UTC day across everyone. 150 turns ~ 750 Groq requests, which keeps
# headroom under the 1,000/day free limit. Past it, new turns are refused.
MAX_TURNS_PER_DAY=150
# Largest accepted audio upload in bytes (default 8 MiB).
# MAX_AUDIO_BYTES=8388608
# Optional shared secret. Unset = open to anyone with the URL. When set, the
# client must present it in the socket handshake (VITE_ACCESS_TOKEN in the
# frontend build, which makes it a casual gate, not a hidden secret).
# ACCESS_TOKEN=change-me

# --- Agent -----------------------------------------------------------------
# Override to repurpose the agent. Leave unset for a general-purpose assistant.
# AGENT_PERSONA=You are a terse assistant for a bike shop. ...
AGENT_GREETING=Hey, I'm listening. What can I help you with?

# --- Brain (optional) -------------------------------------------------------
# LLM_PROVIDER=brain routes reasoning through the Python service in ../brain
# (LangGraph, tools, cost guard). See docs/CONTRACT.md.
# BRAIN_URL=http://localhost:8000
# Sent as a bearer token. Set it when the brain is hosted and has BRAIN_API_KEY.
# BRAIN_API_KEY=
