# Server
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Which LLM backend to stream from: "ollama" (local) or "groq" (hosted)
# Local dev defaults to ollama; deployments should set groq, since running
# Ollama needs more RAM than any free host provides.
LLM_PROVIDER=ollama

# Ollama (local inference)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi3

# Groq — used for Whisper STT always, and for the LLM when LLM_PROVIDER=groq.
# Free API key: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Piper (local TTS)
PIPER_MODEL=en_US-lessac-medium
PIPER_MODEL_PATH=./models/piper
PIPER_BIN=piper
