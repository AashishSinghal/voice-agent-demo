# Server
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- LLM -------------------------------------------------------------------
# "groq"   — hosted, no local model needed. Simplest way to run locally.
# "ollama" — fully local/offline, but needs Ollama installed and a model pulled.
LLM_PROVIDER=groq

# Groq is used for Whisper STT always, and for the LLM when LLM_PROVIDER=groq.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Current free chat models: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b

# Only used when LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi3

# --- TTS -------------------------------------------------------------------
# "say"   — macOS built-in. Zero setup; use this for local dev on a Mac.
# "groq"  — hosted Orpheus. Used in deployment: synthesis is a network call,
#           so it does not care that the free instance has 0.1 vCPU.
# "piper" — local binary + ONNX voice. Needs real CPU.
TTS_PROVIDER=say
SAY_VOICE=Samantha

# Only used when TTS_PROVIDER=groq
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy

# Only used when TTS_PROVIDER=piper
PIPER_MODEL=en_US-lessac-medium
PIPER_MODEL_PATH=./models/piper
PIPER_BIN=piper

# --- Agent -----------------------------------------------------------------
# Override to repurpose the agent. Leave unset for a general-purpose assistant.
# AGENT_PERSONA=You are a terse assistant for a bike shop. ...
AGENT_GREETING=Hey, I'm listening. What can I help you with?
