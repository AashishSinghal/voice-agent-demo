# Copy to .env (gitignored). Read by the brain; real environment variables win.

# fake | ollama | groq
BRAIN_PROVIDER=ollama
# BRAIN_LOCAL_MODEL=llama3.1:8b

# Hosted Postgres (Neon, Supabase, ...). Leave unset locally: SQLite is used.
# Use the POOLED connection string here (Neon: the host contains "-pooler").
# BRAIN_DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# The DIRECT (non-pooled) string, used only by scripts/init_db.py to create tables.
# BRAIN_DATABASE_URL_DIRECT=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Require "Authorization: Bearer <key>" on every /v1 request. Set the same value
# as BRAIN_API_KEY on the gateway. Always set this when the brain is public.
# BRAIN_API_KEY=

# Connector secrets referenced from mcp.json as ${NOTION_TOKEN}
# NOTION_TOKEN=
